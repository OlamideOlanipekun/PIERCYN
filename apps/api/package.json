{
  "name": "@piercyn/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js --external:@prisma/client --external:@prisma/adapter-pg --external:pg --external:bcryptjs",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@piercyn/config": "*",
    "@piercyn/db": "*",
    "@piercyn/types": "*",
    "@piercyn/utils": "*",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.25.0",
    "supertest": "^7.3.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^5.0.1"
  }
}
