# ===================================================
# PIERCYN COMMERCE PLATFORM — ENVIRONMENT CONFIGURATION
# ===================================================

# ── DATABASE (Supabase PostgreSQL via Prisma) ──────────────────────────────
# Runtime connection pooling URL (Supabase pgBouncer port 6543)
DATABASE_URL="postgres://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Direct connection URL (used for migrations, db push, and seeds - port 5432)
DATABASE_URL_NON_POOLING="postgres://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Isolated test/staging PostgreSQL only. Database-backed tests require one of
# these values and refuse to fall back to the production runtime URL.
DATABASE_URL_TEST="postgresql://USER:PASSWORD@TEST_HOST:5432/PIERCYN_TEST?sslmode=require"
DATABASE_URL_NON_POOLING_TEST="postgresql://USER:PASSWORD@TEST_HOST:5432/PIERCYN_TEST?sslmode=require"

# ── API & SERVER CONFIGURATION ─────────────────────────────────────────────
NODE_ENV="development"                                 # Options: development, test, production
PORT=3001                                             # Standalone Express API port (default: 3001)
HOST="0.0.0.0"                                        # API host bind address
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://piercyn.vercel.app" # Comma-separated CORS allowed origins

# ── CRYPTOGRAPHIC & TOKEN SIGNING SECRETS ──────────────────────────────────
# Master JWT secret (used as fallback for signing tokens)
JWT_SECRET="generate_a_secure_random_64_character_hex_string_for_production"
# Mandatory for admin session tokens (defaults to JWT_SECRET if unset)
ADMIN_JWT_SECRET="generate_a_secure_random_64_character_hex_string_for_production"
# Mandatory for customer session tokens (defaults to JWT_SECRET if unset)
CUSTOMER_JWT_SECRET="generate_a_secure_random_64_character_hex_string_for_production"
# Mandatory for guest order tracking link capabilities (defaults to JWT_SECRET if unset)
ORDER_ACCESS_TOKEN_SECRET="generate_a_secure_random_64_character_hex_string_for_production"
# Guest order tracking token lifetime in days (default 30, max 90)
ORDER_ACCESS_TOKEN_TTL_DAYS="30"
# Protects the Vercel cron endpoint that expires unpaid inventory reservations
CRON_SECRET="generate_a_secure_random_64_character_hex_string_for_production"


# ── FRONTEND CONFIGURATION (Vite apps/web) ─────────────────────────────────
# Base API URL for frontend client (leave empty for same-origin /api proxy in production)
VITE_API_URL=""
# Frontend Paystack public key for browser checkout modal
VITE_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
# Optional frontend disable HMR flag
DISABLE_HMR="false"

# ── SUPABASE AUTH & SERVICES ───────────────────────────────────────────────
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_JWT_SECRET="<jwt-secret>"

# ── PAYMENT GATEWAY & BANK TRANSFER ─────────────────────────────────────────
PAYMENT_PROVIDER="direct_transfer"                    # Options: direct_transfer, paystack, mock
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_WEBHOOK_SECRET="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"

# Official Kuda bank-transfer recipient details (server-side single source of truth)
BANK_NAME="Kuda"
BANK_ACCOUNT_NAME="Adedeji Taiwo"
BANK_ACCOUNT_NUMBER="2072114942"


# ── APPLICATION URLS ───────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
